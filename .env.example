# Copy to .env and edit. Every setting has a default, so an empty .env still works.

# Folder of markdown notes to index. Defaults to the demo corpus in data/notes.
NOTES_DIR=data/notes

# local = numpy index on this machine, pinecone = hosted ANN index.
# Leave unset and it picks pinecone when PINECONE_API_KEY is present, otherwise local.
INDEX_BACKEND=local

# sentence-transformers is the real embedder; hashing is a dependency-free fallback
# for smoke tests only and its results should not be reported.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only needed for the pinecone backend.
PINECONE_API_KEY=
PINECONE_INDEX=noterecall
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Where the local backend keeps its vectors.
LOCAL_INDEX_DIR=.index

CHUNK_SIZE=256
CHUNK_OVERLAP=32
TOP_K=5
